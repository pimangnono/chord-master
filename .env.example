# Copy to .env and fill in. Read only by the local Vite server (npm run dev /
# npm run preview) for the song auto-fill; never sent to the browser.
# Create a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: path to yt-dlp if it is not on PATH (brew install yt-dlp).
# Used by "원곡에 박자 맞추기" to stream a YouTube video's audio for analysis;
# nothing is saved to disk.
# YTDLP_PATH=/opt/homebrew/bin/yt-dlp
